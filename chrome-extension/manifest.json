{
  "manifest_version": 3,
  "name": "Synchro",
  "version": "0.4.0",
  "description": "Отправить текущую вкладку с компьютера на телефон по локальной сети.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_icon": {
      "32": "icon32.png",
      "16": "icon16.png"
    },
    "default_title": "Synchro — отправить вкладку",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon128.png",
    "16": "icon16.png",
    "48": "icon48.png"
  },
  "commands": {
    "_execute_action": {
      "description": "Отправить текущую вкладку",
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  }
}
